<script>

function show(id,el){

document
.querySelectorAll('.page')
.forEach(p =>
p.classList.remove('active')
);

const page =
document.getElementById(id);

if(page){
page.classList.add('active');
}

if(el){

document
.querySelectorAll('.nav')
.forEach(n =>
n.classList.remove('active')
);

el.classList.add('active');

}

window.scrollTo(0,0);

}


function toast(t){

let x =
document.getElementById('toast');

x.textContent=t;

x.style.display='block';

clearTimeout(window.tt);

window.tt=setTimeout(
() =>
x.style.display='none',
1800
);

}


function gift(){

let x =
document.getElementById('giftCount');

x.textContent =
+x.textContent+1;

toast(
'🎁 Gift sent! Creator earned extra'
);

}


function sendChat(){

let m =
prompt(
'Write a chat message'
);

if(m){

let c =
document.getElementById('chat');

c.innerHTML +=
`<div class="msg">
<b>You:</b> ${m}
</div>`;

c.scrollTop =
c.scrollHeight;

}

}


function publish(){

let c =
document
.getElementById('caption')
.value
.trim();

toast(
c
?
'Published successfully'
:
'Add a caption or media first'
);

}


function previewMedia(e){

let f =
e.target.files[0];

if(!f)return;

let img =
document.getElementById('imgPreview');

let vid =
document.getElementById('vidPreview');

img.style.display='none';

vid.style.display='none';

let u =
URL.createObjectURL(f);

if(
f.type.startsWith('image/')
){

img.src=u;

img.style.display='block';

}else{

vid.src=u;

vid.style.display='block';

}

}


function buyCoins(n){

toast(
n+' coins selected for purchase'
);

}


function filterCards(v){

document
.querySelectorAll(
'#discoverCards .card'
)
.forEach(c => {

c.style.display =
c.innerText
.toLowerCase()
.includes(
v.toLowerCase()
)
?
'block'
:
'none';

});

}

</script>

<script>
supabase.auth.getSession().then(({ data, error }) => {
  const test = document.createElement("div");

  test.style.position = "fixed";
  test.style.top = "10px";
  test.style.left = "10px";
  test.style.right = "10px";
  test.style.padding = "15px";
  test.style.background = error ? "#ff0000" : "#00aa00";
  test.style.color = "#ffffff";
  test.style.zIndex = "99999";
  test.style.textAlign = "center";
  test.style.fontWeight = "bold";

  test.textContent = error
    ? "❌ Supabase connection failed"
    : "✅ Supabase connected successfully";

  document.body.appendChild(test);
});
</script>
